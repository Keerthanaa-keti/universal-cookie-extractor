# Cookie Vault v3 — remote server config. Copy to .env (gitignored) and fill in.
# A server needs ONLY these. No password, no master key, no Supabase key.

COOKIE_VAULT_BROKER_URL="https://<project-ref>.supabase.co/functions/v1/cookie-broker"
COOKIE_VAULT_TOKEN="cvk_..."                       # issued in the extension Tokens tab (shown once)
COOKIE_VAULT_KEY_FILE="~/.cookie-vault/my-server.key"   # from: keygen --label my-server

# Alternatives to COOKIE_VAULT_KEY_FILE:
#   COOKIE_VAULT_PRIVATE_KEY="<base64url raw X25519 private key>"   # Python only
#   COOKIE_VAULT_KEY_LABEL="my-server"                              # loads ~/.cookie-vault/<label>.key
